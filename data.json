<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#071C16">
<title>Duffs Way — Tiger v12</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --board:#071C16;
  --turf:#0B2B22;
  --slat:#123A2E;
  --slat-hi:#17493a;
  --chalk:#EDE8DA;
  --bulb:#F2A83B;
  --rail:#6FB79A;
  --silks:#C7402F;
  --win:#57C08A;
  --pad:14px;
  --r:10px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  background:var(--board);
  color:var(--chalk);
  font-family:Inter,-apple-system,system-ui,sans-serif;
  font-size:15px;line-height:1.45;
  padding-bottom:env(safe-area-inset-bottom);
  overflow-x:hidden;
}
h1,h2,h3,.disp{font-family:"Barlow Condensed",Inter,sans-serif;letter-spacing:.02em;text-transform:uppercase;margin:0}
.num{font-family:"IBM Plex Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums}
.wrap{max-width:760px;margin:0 auto;padding:0 var(--pad)}

/* ---------- header ---------- */
header{
  position:sticky;top:0;z-index:40;
  background:linear-gradient(180deg,var(--board) 78%,rgba(7,28,22,0));
  padding-top:calc(env(safe-area-inset-top) + 10px);
}
.brandrow{display:flex;align-items:baseline;gap:10px;padding-bottom:8px}
.brand{font-size:30px;font-weight:800;line-height:.95}
.brand span{color:var(--bulb)}
.stamp{font-size:11px;letter-spacing:.14em;color:var(--rail);font-family:"IBM Plex Mono",monospace;margin-left:auto}
.seg{display:flex;gap:4px;background:var(--turf);border-radius:999px;padding:4px;margin-bottom:10px}
.seg button{
  flex:1;border:0;background:none;color:var(--rail);
  font-family:"Barlow Condensed",sans-serif;font-size:17px;font-weight:700;
  text-transform:uppercase;letter-spacing:.08em;padding:9px 0;border-radius:999px;cursor:pointer;
  transition:background .18s,color .18s;
}
.seg button[aria-selected="true"]{background:var(--bulb);color:var(--board)}
.seg button:focus-visible{outline:2px solid var(--chalk);outline-offset:2px}

/* ---------- meeting chips ---------- */
.chips{display:flex;gap:8px;overflow-x:auto;padding:2px 0 12px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{
  flex:0 0 auto;border:1px solid rgba(111,183,154,.35);background:var(--turf);
  color:var(--chalk);border-radius:var(--r);padding:7px 13px;cursor:pointer;
  font-family:"Barlow Condensed",sans-serif;font-size:16px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;
}
.chip[aria-pressed="true"]{background:var(--slat-hi);border-color:var(--bulb);color:var(--bulb)}
.chip small{display:block;font-family:"IBM Plex Mono",monospace;font-size:10px;font-weight:500;letter-spacing:0;text-transform:none;color:var(--rail)}

/* ---------- track circuit (signature) ---------- */
.circuit{
  background:var(--turf);border-radius:var(--r);padding:12px;margin-bottom:12px;
  display:flex;gap:14px;align-items:center;
}
.circuit svg{flex:0 0 132px;width:132px;height:88px;overflow:visible}
.cond{display:grid;gap:6px;font-size:12px;min-width:0}
.cond div{display:flex;gap:8px;align-items:baseline}
.cond b{font-family:"Barlow Condensed",sans-serif;font-size:11px;letter-spacing:.12em;color:var(--rail);text-transform:uppercase;flex:0 0 62px}
.cond span{color:var(--chalk);font-family:"IBM Plex Mono",monospace;font-size:12px}
.runner{fill:var(--bulb)}
@media (prefers-reduced-motion:reduce){.runner-anim{display:none}}

/* ---------- tabs ---------- */
.tabs{display:flex;gap:6px;margin-bottom:12px}
.tabs button{
  flex:1;border:1px solid rgba(111,183,154,.28);background:transparent;color:var(--rail);
  border-radius:var(--r);padding:8px 4px;cursor:pointer;
  font-family:"Barlow Condensed",sans-serif;font-size:14px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
}
.tabs button[aria-selected="true"]{background:var(--slat);color:var(--chalk);border-color:var(--bulb)}

/* ---------- slats ---------- */
.slat{
  background:var(--slat);border-radius:var(--r);margin-bottom:8px;
  border-left:4px solid transparent;overflow:hidden;
}
.slat.win{border-left-color:var(--win)}
.slat.place{border-left-color:var(--bulb)}
.slat.roughie{border-left-color:var(--silks)}
.slat-main{display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;padding:11px 12px}
.rno{font-family:"Barlow Condensed",sans-serif;font-size:20px;font-weight:800;color:var(--rail);text-align:center}
.hname{font-family:"Barlow Condensed",sans-serif;font-size:20px;font-weight:700;line-height:1.05}
.meta{font-size:11px;color:var(--rail);font-family:"IBM Plex Mono",monospace;margin-top:2px}
.flags{font-size:13px;letter-spacing:1px;margin-top:3px}
.gd{text-align:right}
.gdnum{font-family:"IBM Plex Mono",monospace;font-size:22px;font-weight:600;color:var(--bulb);line-height:1}
.gdnum.shift{color:var(--win)}
.gdnum.shift.down{color:var(--silks)}
.bet{font-family:"Barlow Condensed",sans-serif;font-size:12px;letter-spacing:.1em;font-weight:700;margin-top:3px}
.bet.win{color:var(--win)}.bet.place{color:var(--bulb)}.bet.roughie{color:var(--silks)}
.price{font-family:"IBM Plex Mono",monospace;font-size:13px;color:var(--chalk)}

/* result checkboxes */
.result{display:flex;gap:6px;padding:0 12px 10px 56px}
.result label{
  flex:0 0 auto;font-family:"Barlow Condensed",sans-serif;font-size:12px;font-weight:700;letter-spacing:.1em;
  border:1px solid rgba(111,183,154,.3);border-radius:6px;padding:3px 11px;cursor:pointer;color:var(--rail);
}
.result input{position:absolute;opacity:0;width:0;height:0}
.result input:checked+span{color:var(--board)}
.result label:has(input:checked){background:var(--rail);color:var(--board);border-color:var(--rail)}
.result label.w:has(input:checked){background:var(--win);border-color:var(--win)}
.result label.p:has(input:checked){background:var(--bulb);border-color:var(--bulb)}
.result label.l:has(input:checked){background:var(--silks);border-color:var(--silks);color:var(--chalk)}
.result label:focus-within{outline:2px solid var(--chalk);outline-offset:2px}

/* ---------- strike bar ---------- */
.strike{
  position:sticky;bottom:0;z-index:30;margin:14px calc(var(--pad) * -1) 0;
  background:var(--turf);border-top:1px solid rgba(111,183,154,.25);
  padding:10px var(--pad) calc(10px + env(safe-area-inset-bottom));
  display:flex;align-items:center;gap:12px;
}
.strike .big{font-family:"IBM Plex Mono",monospace;font-size:22px;font-weight:600;color:var(--bulb)}
.strike small{font-size:11px;color:var(--rail);font-family:"Barlow Condensed",sans-serif;letter-spacing:.1em;text-transform:uppercase}
.strike .reset{margin-left:auto;background:none;border:1px solid rgba(111,183,154,.35);color:var(--rail);border-radius:6px;padding:5px 10px;font-size:11px;cursor:pointer;font-family:"Barlow Condensed",sans-serif;letter-spacing:.1em;text-transform:uppercase}

/* ---------- pace toggle ---------- */
.pacebar{display:flex;align-items:center;gap:10px;background:var(--turf);border-radius:var(--r);padding:9px 12px;margin-bottom:12px}
.pacebar .lbl{font-family:"Barlow Condensed",sans-serif;font-size:14px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.pacebar .sub{font-size:11px;color:var(--rail);margin-left:auto;text-align:right;max-width:52%}
.sw{position:relative;width:44px;height:25px;flex:0 0 44px}
.sw input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
.sw i{position:absolute;inset:0;background:var(--slat);border-radius:999px;transition:background .18s}
.sw i::after{content:"";position:absolute;top:3px;left:3px;width:19px;height:19px;border-radius:50%;background:var(--rail);transition:transform .18s,background .18s}
.sw input:checked+i{background:rgba(242,168,59,.3)}
.sw input:checked+i::after{transform:translateX(19px);background:var(--bulb)}
.sw input:focus-visible+i{outline:2px solid var(--chalk);outline-offset:2px}

/* ---------- favs / h2h ---------- */
.fav{background:var(--slat);border-radius:var(--r);padding:11px 12px;margin-bottom:8px;display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center}
.fav .trap{color:var(--silks);font-family:"Barlow Condensed",sans-serif;font-size:11px;letter-spacing:.1em;text-transform:uppercase}
.fav .agree{color:var(--win);font-family:"Barlow Condensed",sans-serif;font-size:11px;letter-spacing:.1em;text-transform:uppercase}
.h2h{background:var(--slat);border-radius:var(--r);padding:12px;margin-bottom:8px}
.h2h .top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:9px;gap:8px}
.h2h .side{font-family:"Barlow Condensed",sans-serif;font-size:17px;font-weight:700;line-height:1.05}
.h2h .side.b{text-align:right;color:var(--rail)}
.bars{display:grid;gap:6px}
.bar{display:grid;grid-template-columns:1fr 54px 1fr;align-items:center;gap:8px}
.bar em{font-style:normal;font-family:"Barlow Condensed",sans-serif;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--rail);text-align:center}
.track{height:7px;background:rgba(7,28,22,.6);border-radius:4px;overflow:hidden;display:flex}
.track.l{justify-content:flex-end}
.track i{display:block;height:100%;background:var(--bulb)}
.track.r i{background:var(--rail)}

/* ---------- NRL ---------- */
.game{background:var(--slat);border-radius:var(--r);padding:11px 12px;margin-bottom:8px;border-left:4px solid transparent}
.game.top{border-left-color:var(--bulb)}
.gtop{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.gvs{font-family:"Barlow Condensed",sans-serif;font-size:18px;font-weight:700}
.gvs u{text-decoration:none;color:var(--bulb)}
.gmeta{font-size:11px;color:var(--rail);font-family:"IBM Plex Mono",monospace;margin-top:4px;display:flex;gap:12px;flex-wrap:wrap}
.multi{background:var(--slat);border-radius:var(--r);padding:11px 12px;margin-bottom:8px;display:flex;justify-content:space-between;gap:10px;align-items:center}
.multi .legs{font-size:13px}
.multi .odds{font-family:"IBM Plex Mono",monospace;font-size:19px;color:var(--bulb)}

/* ---------- legend + footer ---------- */
.sec{font-family:"Barlow Condensed",sans-serif;font-size:13px;letter-spacing:.16em;color:var(--rail);text-transform:uppercase;margin:22px 0 9px;display:flex;align-items:center;gap:10px}
.sec::after{content:"";flex:1;height:1px;background:rgba(111,183,154,.22)}
.legend{background:var(--turf);border-radius:var(--r);padding:12px;font-size:12.5px}
.legend ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:6px 12px}
.legend li span{display:inline-block;width:20px}
.legend p{margin:10px 0 0;color:var(--rail);font-size:12px;line-height:1.5}
.books{display:flex;gap:8px;margin:14px 0 26px}
.books a{
  flex:1;text-align:center;text-decoration:none;background:var(--slat);color:var(--chalk);
  border-radius:var(--r);padding:11px 4px;font-family:"Barlow Condensed",sans-serif;
  font-size:15px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;
  border:1px solid rgba(111,183,154,.25);
}
.books a:active{background:var(--slat-hi)}
.foot{font-size:11px;color:rgba(111,183,154,.65);text-align:center;padding-bottom:20px;line-height:1.6}
.banner{background:rgba(242,168,59,.12);border:1px solid rgba(242,168,59,.4);color:var(--bulb);border-radius:var(--r);padding:9px 12px;font-size:12px;margin-bottom:12px}
[hidden]{display:none !important}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <div class="brandrow">
      <h1 class="brand">Duffs<span>Way</span></h1>
      <span class="stamp" id="stamp">TIGER v12</span>
    </div>
    <div class="seg" role="tablist" aria-label="Sport">
      <button role="tab" id="mode-racing" aria-selected="true" aria-controls="panel-racing">Racing</button>
      <button role="tab" id="mode-nrl" aria-selected="false" aria-controls="panel-nrl">NRL</button>
    </div>
  </div>
</header>

<main class="wrap">
  <div class="banner" id="banner" hidden></div>

  <!-- ============ RACING ============ -->
  <section id="panel-racing" role="tabpanel" aria-labelledby="mode-racing">
    <div class="chips" id="chips" role="group" aria-label="Meetings"></div>

    <div class="circuit">
      <svg viewBox="0 0 200 130" aria-hidden="true">
        <path id="outer" d="M60,14 H140 A46,46 0 0 1 140,116 H60 A46,46 0 0 1 60,14 Z"
              fill="none" stroke="#0B2B22" stroke-width="17"/>
        <path id="lane" d="M60,14 H140 A46,46 0 0 1 140,116 H60 A46,46 0 0 1 60,14 Z"
              fill="none" stroke="#6FB79A" stroke-width="1.2" stroke-dasharray="3 4" opacity=".55"/>
        <path id="railline" d="M60,26 H140 A34,34 0 0 1 140,104 H60 A34,34 0 0 1 60,26 Z"
              fill="none" stroke="#F2A83B" stroke-width="1.6" opacity=".85"/>
        <circle class="runner" r="4.5">
          <animateMotion class="runner-anim" id="motion" dur="7s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
            <mpath href="#outer"/>
          </animateMotion>
        </circle>
        <text x="100" y="69" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="9" fill="#6FB79A" id="dirLabel">CW</text>
      </svg>
      <div class="cond">
        <div><b>Track</b><span id="c-track">—</span></div>
        <div><b>Going</b><span id="c-cond">—</span></div>
        <div><b>Rail</b><span id="c-rail">—</span></div>
        <div><b>Bias</b><span id="c-bias">—</span></div>
      </div>
    </div>

    <div class="pacebar">
      <label class="sw"><input type="checkbox" id="pace"><i></i></label>
      <span class="lbl">Pace override</span>
      <span class="sub">Rewards on-pace runners, penalises backmarkers</span>
    </div>

    <div class="tabs" role="tablist" aria-label="View">
      <button role="tab" data-view="card" aria-selected="true">📊 Duffs Way</button>
      <button role="tab" data-view="favs" aria-selected="false">💲 Favs</button>
      <button role="tab" data-view="h2h" aria-selected="false">⚔️ H2H</button>
    </div>

    <div id="racingBody"></div>
  </section>

  <!-- ============ NRL ============ -->
  <section id="panel-nrl" role="tabpanel" aria-labelledby="mode-nrl" hidden>
    <div id="nrlBody"></div>
  </section>

  <div class="sec">Legend</div>
  <div class="legend">
    <ul>
      <li><span>🏆</span>Banker</li>
      <li><span>🔥</span>High confidence</li>
      <li><span>✅</span>Solid</li>
      <li><span>⚠️</span>Marginal</li>
      <li><span>🐴</span>Roughie</li>
      <li><span>👑</span>Banker tag</li>
      <li><span>🧠</span>Smart money</li>
      <li><span>📉</span>Class drop</li>
      <li><span>🎯</span>Jockey flag</li>
      <li><span>🌧️</span>Wet specialist</li>
      <li><span>🚪</span>Wide gate</li>
      <li><span>💪</span>New stable</li>
      <li><span>⚙️</span>Gear change</li>
      <li><span>🍀</span>Bad luck last start</li>
      <li><span>📏</span>Bias runner</li>
      <li><span>🚨</span>Drifter, model strong</li>
      <li><span>⚡</span>Fast sectionals</li>
    </ul>
    <p><b>Pace override</b> — switch it on and every on-pace runner gains 0.30 on its GD score while every backmarker loses 0.30. Use it on days the rail is out and the track is riding on-pace. Scores that move turn green or red, and bet types re-rate if they cross a threshold. Switch it off to see the raw engine numbers.</p>
    <p><b>W / P / L</b> — tap a result after each race. The strike rate at the bottom counts wins and places against every race you've marked. It's kept on this phone only.</p>
  </div>

  <div class="sec">Bookmakers</div>
  <div class="books">
    <a href="https://www.sportsbet.com.au" target="_blank" rel="noopener">Sportsbet</a>
    <a href="https://www.bet365.com.au" target="_blank" rel="noopener">Bet365</a>
    <a href="https://www.ladbrokes.com.au" target="_blank" rel="noopener">Ladbrokes</a>
  </div>

  <p class="foot">Duffs Way · Tiger v12 racing engine · GD Algo V1 league engine<br>Model output, not advice. Gamble responsibly — 1800 858 858.</p>

  <div class="strike">
    <span class="big" id="srate">—</span>
    <small>Strike rate<br><span id="scount" style="letter-spacing:0;text-transform:none">No races marked</span></small>
    <button class="reset" id="reset">Clear</button>
  </div>
</main>

<script>
"use strict";

const FALLBACK = {"meta":{"engine":"TIGER v12","generated":"—","label":"Data file not loaded","sample":true},"racing":{"meetings":[]},"nrl":{"engine":"GD ALGO V1","round":"—","games":[],"multis":[]}};

let DATA = FALLBACK, meetingIdx = 0, view = "card", paceOn = false;

const mem = {};
const store = {
  get(k){ try { return localStorage.getItem(k); } catch(e){ return mem[k] ?? null; } },
  set(k,v){ try { localStorage.setItem(k,v); } catch(e){ mem[k]=v; } },
  del(k){ try { localStorage.removeItem(k); } catch(e){ delete mem[k]; } }
};
const resKey = () => "dw:" + (DATA.meta.generated || "x");
let results = {};
function loadResults(){ try { results = JSON.parse(store.get(resKey()) || "{}"); } catch(e){ results = {}; } }
function saveResults(){ store.set(resKey(), JSON.stringify(results)); }

const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

function adjusted(r){
  if(!paceOn) return { gd:r.gd, delta:0 };
  const d = r.pace === "on" ? 0.30 : r.pace === "back" ? -0.30 : 0;
  return { gd: Math.round((r.gd + d) * 100) / 100, delta: d };
}
function betFor(gd, orig){
  if(gd >= 7.70) return orig === "ROUGHIE" ? "ROUGHIE" : "WIN";
  if(gd >= 7.00) return orig === "ROUGHIE" ? "ROUGHIE" : "PLACE";
  return "AVOID";
}

function renderChips(){
  const ms = DATA.racing.meetings;
  $("#chips").innerHTML = ms.map((m,i)=>
    `<button class="chip" aria-pressed="${i===meetingIdx}" data-i="${i}">${esc(m.track)}<small>${esc(m.condition)} · ${esc(m.rail)}</small></button>`
  ).join("") || `<span style="color:var(--rail);font-size:13px">No meetings in data.json</span>`;
}

function renderCircuit(){
  const m = DATA.racing.meetings[meetingIdx];
  if(!m) return;
  $("#c-track").textContent = m.track + " · " + (m.straight || "");
  $("#c-cond").textContent  = m.condition;
  $("#c-rail").textContent  = m.rail;
  $("#c-bias").textContent  = (m.biasZone || "—") + " (str " + (m.biasStrength ?? 0) + ")";
  const cw = (m.direction || "clockwise") === "clockwise";
  $("#dirLabel").textContent = cw ? "CW" : "ACW";
  const mo = $("#motion");
  mo.setAttribute("keyPoints", cw ? "0;1" : "1;0");
  const p = mo.parentNode, n = mo.cloneNode(true);
  p.replaceChild(n, mo);
}

function renderRacing(){
  const m = DATA.racing.meetings[meetingIdx];
  const box = $("#racingBody");
  if(!m){ box.innerHTML = `<p style="color:var(--rail)">Drop a data.json in the repo root to fill this card.</p>`; return; }

  if(view === "card"){
    box.innerHTML = m.races.map(r=>{
      const a = adjusted(r);
      const bet = betFor(a.gd, r.bet);
      const cls = bet.toLowerCase();
      const shift = a.delta ? ` shift${a.delta < 0 ? " down" : ""}` : "";
      const id = m.id + "-" + r.no;
      const cur = results[id] || "";
      return `<article class="slat ${cls}">
        <div class="slat-main">
          <div class="rno">R${r.no}</div>
          <div>
            <div class="hname">${esc(r.horse)}</div>
            <div class="meta"><span class="price">${esc(r.price)}</span> · ${esc((r.pace||"mid").toUpperCase())}-PACE</div>
            <div class="flags">${(r.flags||[]).join(" ")}</div>
          </div>
          <div class="gd">
            <div class="gdnum${shift}">${a.gd.toFixed(2)}</div>
            <div class="bet ${cls}">${bet}</div>
          </div>
        </div>
        <div class="result" data-id="${id}">
          <label class="w"><input type="radio" name="r-${id}" value="W" ${cur==="W"?"checked":""}><span>W</span></label>
          <label class="p"><input type="radio" name="r-${id}" value="P" ${cur==="P"?"checked":""}><span>P</span></label>
          <label class="l"><input type="radio" name="r-${id}" value="L" ${cur==="L"?"checked":""}><span>L</span></label>
        </div>
      </article>`;
    }).join("");
  }

  if(view === "favs"){
    box.innerHTML = m.races.map(r=>{
      const f = r.fav || {};
      const agree = f.name === r.horse;
      const trap = !agree && f.gd < 7.50;
      return `<article class="fav">
        <div class="rno">R${r.no}</div>
        <div>
          <div class="hname">${esc(f.name || "—")}</div>
          <div class="meta"><span class="price">${esc(f.price||"—")}</span> · model ${(f.gd??0).toFixed(2)}</div>
          <div class="${agree?"agree":trap?"trap":"meta"}">${agree ? "Model agrees" : trap ? "⚠️ Value trap — we're on " + esc(r.horse) : "Model prefers " + esc(r.horse)}</div>
        </div>
        <div class="gdnum">${(f.gd??0).toFixed(2)}</div>
      </article>`;
    }).join("");
  }

  if(view === "h2h"){
    const keys = [["form","Form"],["speed","Speed"],["barrier","Barrier"],["market","Market"]];
    box.innerHTML = m.races.map(r=>{
      const h = r.h2h; if(!h) return "";
      return `<article class="h2h">
        <div class="top">
          <div class="side">R${r.no} ${esc(h.a.name)}<br><span class="price">GD ${h.a.gd.toFixed(2)}</span></div>
          <div class="side b">${esc(h.b.name)}<br><span class="price">GD ${h.b.gd.toFixed(2)}</span></div>
        </div>
        <div class="bars">${keys.map(([k,label])=>`
          <div class="bar">
            <div class="track l"><i style="width:${(h.a[k]||0)*10}%"></i></div>
            <em>${label}</em>
            <div class="track r"><i style="width:${(h.b[k]||0)*10}%"></i></div>
          </div>`).join("")}
        </div>
      </article>`;
    }).join("");
  }
  updateStrike();
}

function renderNRL(){
  const n = DATA.nrl || {};
  const games = (n.games||[]).slice().sort((a,b)=>b.gd-a.gd);
  const top3 = new Set(games.slice(0,3).map(g=>g.home+g.away));
  $("#nrlBody").innerHTML = `
    <div class="sec" style="margin-top:2px">${esc(n.engine||"GD ALGO V1")} · ${esc(n.round||"")}</div>
    ${games.map(g=>{
      const isTop = top3.has(g.home+g.away);
      const pickHome = g.pick === g.home;
      return `<article class="game ${isTop?"top":""}">
        <div class="gtop">
          <div class="gvs">${pickHome?`<u>${esc(g.home)}</u>`:esc(g.home)} v ${!pickHome?`<u>${esc(g.away)}</u>`:esc(g.away)}</div>
          <div class="gdnum">${g.gd.toFixed(2)}</div>
        </div>
        <div class="gmeta">
          <span>${esc(g.line)} ${esc(g.odds)}</span>
          <span>🏉 ${esc(g.tryScorer)}</span>
          ${isTop?`<span style="color:var(--bulb)">TOP 3</span>`:""}
        </div>
      </article>`;
    }).join("") || `<p style="color:var(--rail)">No games in data.json</p>`}
    <div class="sec">Multis</div>
    ${(n.multis||[]).map(mu=>`<div class="multi">
      <div><div class="hname" style="font-size:16px">${esc(mu.name)}</div><div class="legs" style="color:var(--rail)">${mu.legs.map(esc).join(" · ")}</div></div>
      <div class="odds">${esc(mu.odds)}</div>
    </div>`).join("")}
    <p style="color:var(--rail);font-size:12px">Suggested only — you finalise the multis.</p>`;
}

function updateStrike(){
  const vals = Object.values(results);
  const n = vals.length;
  const hits = vals.filter(v=>v==="W"||v==="P").length;
  const wins = vals.filter(v=>v==="W").length;
  if(!n){ $("#srate").textContent = "—"; $("#scount").textContent = "No races marked"; return; }
  $("#srate").textContent = Math.round(hits/n*100) + "%";
  $("#scount").textContent = `${wins} win · ${hits-wins} place · ${n-hits} loss of ${n}`;
}

$("#chips").addEventListener("click", e=>{
  const b = e.target.closest(".chip"); if(!b) return;
  meetingIdx = +b.dataset.i;
  renderChips(); renderCircuit(); renderRacing();
});
document.querySelector(".tabs").addEventListener("click", e=>{
  const b = e.target.closest("button"); if(!b) return;
  view = b.dataset.view;
  document.querySelectorAll(".tabs button").forEach(x=>x.setAttribute("aria-selected", String(x===b)));
  renderRacing();
});
$("#pace").addEventListener("change", e=>{ paceOn = e.target.checked; renderRacing(); });
$("#racingBody").addEventListener("change", e=>{
  const wrap = e.target.closest(".result"); if(!wrap) return;
  results[wrap.dataset.id] = e.target.value;
  saveResults(); updateStrike();
});
$("#reset").addEventListener("click", ()=>{
  results = {}; saveResults(); renderRacing(); updateStrike();
});
document.querySelectorAll(".seg button").forEach(btn=>{
  btn.addEventListener("click", ()=>{
    const racing = btn.id === "mode-racing";
    $("#mode-racing").setAttribute("aria-selected", String(racing));
    $("#mode-nrl").setAttribute("aria-selected", String(!racing));
    $("#panel-racing").hidden = !racing;
    $("#panel-nrl").hidden = racing;
    document.querySelector(".strike").hidden = !racing;
    window.scrollTo({top:0});
  });
});

fetch("data.json", {cache:"no-store"})
  .then(r=>{ if(!r.ok) throw new Error(r.status); return r.json(); })
  .then(d=>{ DATA = d; })
  .catch(()=>{ DATA = FALLBACK; $("#banner").hidden = false; $("#banner").textContent = "data.json didn't load — showing an empty card. On GitHub Pages it loads automatically."; })
  .finally(()=>{
    $("#stamp").textContent = (DATA.meta.engine||"TIGER v12") + " · " + (DATA.meta.generated||"");
    if(DATA.meta.sample){ $("#banner").hidden = false; $("#banner").textContent = DATA.meta.label || "Sample card"; }
    loadResults();
    renderChips(); renderCircuit(); renderRacing(); renderNRL(); updateStrike();
  });
</script>
</body>
</html>
